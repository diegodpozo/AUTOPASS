# --- SEGURIDAD JWT ---
SECRET_KEY=autopass_super_secret_key_2026_modular
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- BASE DE DATOS ---
# Base online (Neon/Postgres, sa-east-1 - Sao Paulo): por defecto compartida entre varias PC.
# Para usar SQLite local, reemplazar por: DATABASE_URL=sqlite:///./parking.db
DATABASE_URL=postgresql://neondb_owner:npg_3sJtSwT9dbRK@ep-silent-math-acirnekl.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- BROKER MQTT ---
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_ENTRADA=parking/barrera/entrada/control
MQTT_TOPIC_SALIDA=parking/barrera/salida/control

# --- CONFIGURACION EMAIL (SMTP) ---
SMTP_SERVER=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_mailtrap
SMTP_PASSWORD=tu_password_mailtrap
SMTP_FROM=no-reply@autopass.com.ar

# --- GENERAL ---
BASE_URL=http://localhost:8000
IMAGE_DIR=captured_images

# --- MERCADO PAGO (CHECKOUT PRO) ---
# Credenciales de prueba (modo sandbox): https://www.mercadopago.com.ar/developers/panel
# Compartir credenciales: Access Token de prueba + Public Key de prueba.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# URL base para back_urls del checkout. Con ngrok apuntar la URL pública y el webhook (https://.../v1/user/mercadopago/webhook)
MP_WEBHOOK_URL=
# Minutos de vigencia de la preferencia de pago (expira si no se paga a tiempo).
MP_PREFERENCE_EXPIRE_MINUTES=45

# --- CAMARAS (ALPR) ---
# Puedes usar: 0 (webcam), 1, o una URL de IPWebcam (http://192.168.1.50:8080/video)
VIDEO_SOURCE_ENTRADA=0
VIDEO_SOURCE_SALIDA=0
ALPR_COOLDOWN=6
ALPR_CONFIDENCE_THRESHOLD=0.20
