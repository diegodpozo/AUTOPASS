# --- SEGURIDAD JWT ---
SECRET_KEY=autopass_super_secret_key_2026_modular
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- BASE DE DATOS ---
# SQLite local por defecto
DATABASE_URL=sqlite:///./parking.db
# Para Neon/Postgres (base online), descomentar y completar:
# DATABASE_URL=postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- BROKER MQTT ---
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_ENTRADA=parking/barrera/entrada/control
MQTT_TOPIC_SALIDA=parking/barrera/salida/control

# --- CONFIGURACION EMAIL (SMTP) ---
SMTP_SERVER=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_mailtrap
SMTP_PASSWORD=tu_password_mailtrap
SMTP_FROM=no-reply@autopass.com.ar

# --- GENERAL ---
BASE_URL=http://localhost:8000
IMAGE_DIR=captured_images

# --- CAMARAS (ALPR) ---
# Puedes usar: 0 (webcam), 1, o una URL de IPWebcam (http://192.168.1.50:8080/video)
VIDEO_SOURCE_ENTRADA=0
VIDEO_SOURCE_SALIDA=0
ALPR_COOLDOWN=6
ALPR_CONFIDENCE_THRESHOLD=0.20
