# --- SEGURIDAD JWT ---
SECRET_KEY=autopass_super_secret_key_2026_modular
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- BASE DE DATOS ---
# Base online (Neon/Postgres, sa-east-1 - Sao Paulo): por defecto compartida entre varias PC.
# Para usar SQLite local, reemplazar por: DATABASE_URL=sqlite:///./parking.db
DATABASE_URL=postgresql://neondb_owner:npg_3sJtSwT9dbRK@ep-silent-math-acirnekl.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- BROKER MQTT ---
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_ENTRADA=parking/barrera/entrada/control
MQTT_TOPIC_SALIDA=parking/barrera/salida/control

# --- CONFIGURACION EMAIL (SMTP) ---
SMTP_SERVER=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_mailtrap
SMTP_PASSWORD=tu_password_mailtrap
SMTP_FROM=no-reply@autopass.com.ar

# --- GENERAL ---
BASE_URL=http://localhost:8000
IMAGE_DIR=captured_images

# --- MERCADO PAGO (CHECKOUT PRO) ---
# Credenciales de prueba (modo sandbox): https://www.mercadopago.com.ar/developers/panel
# Compartir credenciales: Access Token de prueba + Public Key de prueba.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# URL base para back_urls del checkout. Con cloudflared/túnel apuntar la URL pública y el webhook (https://.../v1/user/mercadopago/webhook)
MP_WEBHOOK_URL=
# Minutos de vigencia de la preferencia de pago (expira si no se paga a tiempo).
MP_PREFERENCE_EXPIRE_MINUTES=45

# --- CAMARAS (ALPR) ---
# Puedes usar: 0 (webcam), 1, o una URL de IPWebcam (http://192.168.1.50:8080/video)
VIDEO_SOURCE_ENTRADA=0
VIDEO_SOURCE_SALIDA=0
ALPR_COOLDOWN=6
ALPR_CONFIDENCE_THRESHOLD=0.20

# --- LOGIN SOCIAL (OAUTH 2.0) ---
# Google: https://console.cloud.google.com/ -> APIs y servicios -> Credenciales -> Crear credenciales -> ID de cliente OAuth 2.0 (Aplicación web).
# Redirect URI a agregar en el proveedor: {BASE_URL}/v1/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps -> Configuración -> Básico (ID y Secreto de la App) + Producto "Inicio de sesión con Facebook".
# Redirect URI: {BASE_URL}/v1/auth/oauth/facebook/callback (agregar en "URI de redireccionamiento de OAuth de cliente de iOS/Web" si aplica).
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
# Para que los botones se muestren, BASE_URL debe coincidir con la redirect URI registrada (ej: https://tunel.trycloudflare.com en pruebas).
OAUTH_STATE_TTL_SECONDS=600
OAUTH_SIGNUP_EXPIRE_MINUTES=15
